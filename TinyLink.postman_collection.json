{
	"info": {
		"_postman_id": "tinylink-api-collection",
		"name": "TinyLink API",
		"description": "REST API for TinyLink URL Shortener — built with Laravel 11 + Sanctum.\n\n**Setup:**\n1. Import this collection\n2. Create a Postman Environment with:\n   - `base_url` = `http://localhost:8000`\n   - `token` = (leave empty, auto-filled after login/register)\n3. Run Register or Login first to populate the token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('token', json.data.token);",
									"    console.log('Token saved:', json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": ["{{base_url}}"],
							"path": ["api", "register"]
						},
						"description": "Register a new user. On success, the Bearer token is automatically saved to the `token` collection variable."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('token', json.data.token);",
									"    console.log('Token saved:', json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alice@example.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						},
						"description": "Login with existing credentials. On success, the Bearer token is automatically saved to the `token` collection variable."
					},
					"response": []
				},
				{
					"name": "Me (Get Current User)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/me",
							"host": ["{{base_url}}"],
							"path": ["api", "me"]
						},
						"description": "Returns the currently authenticated user's info (no password exposed)."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "logout"]
						},
						"description": "Revokes the current Bearer token. The token will no longer work after this."
					},
					"response": []
				}
			]
		},
		{
			"name": "URL Management",
			"item": [
				{
					"name": "Create Short URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"url\": \"https://example.com/this-is-a-very-long-url-that-needs-shortening\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/urls",
							"host": ["{{base_url}}"],
							"path": ["api", "urls"]
						},
						"description": "Creates a new short URL. Returns the generated short_code. click_count starts at 0."
					},
					"response": []
				},
				{
					"name": "Create Short URL with Custom Code (Bonus)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"url\": \"https://example.com\",\n    \"custom_code\": \"my-link\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/urls",
							"host": ["{{base_url}}"],
							"path": ["api", "urls"]
						},
						"description": "Creates a new short URL with a custom short code. The code must be unique, 3-20 chars, alphanumeric with dashes/underscores."
					},
					"response": []
				},
				{
					"name": "List My URLs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/urls?page=1&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["api", "urls"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								}
							]
						},
						"description": "Returns a paginated list of URLs belonging to the authenticated user ONLY."
					},
					"response": []
				},
				{
					"name": "View URL Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/urls/1",
							"host": ["{{base_url}}"],
							"path": ["api", "urls", "1"]
						},
						"description": "Returns details for a specific URL. Returns 403 if the URL belongs to another user."
					},
					"response": []
				},
				{
					"name": "Delete URL",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/urls/1",
							"host": ["{{base_url}}"],
							"path": ["api", "urls", "1"]
						},
						"description": "Deletes a specific URL. Returns 403 if the URL belongs to another user."
					},
					"response": []
				},
				{
					"name": "URL Statistics (Bonus)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/urls/1/stats",
							"host": ["{{base_url}}"],
							"path": ["api", "urls", "1", "stats"]
						},
						"description": "Returns click statistics for a URL. Respects ownership (403 for other users' URLs)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Public Redirect",
			"item": [
				{
					"name": "Short URL Redirect",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/laravel",
							"host": ["{{base_url}}"],
							"path": ["laravel"]
						},
						"description": "Public endpoint — no authentication required.\n\nRedirects to the original URL and atomically increments click_count.\n\nReplace 'laravel' with any valid short_code from your database.\n\n**Seeded short codes to try:**\n- laravel → https://laravel.com/docs/11.x\n- ghlar → https://github.com/laravel/laravel\n- sanctum → https://packagist.org/packages/laravel/sanctum\n- google → https://www.google.com\n- postmn → https://www.postman.com"
					},
					"response": []
				},
				{
					"name": "Invalid Short Code (404)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/doesnotexist",
							"host": ["{{base_url}}"],
							"path": ["doesnotexist"]
						},
						"description": "Returns 404 JSON response when the short code is not found in the database."
					},
					"response": []
				}
			]
		}
	]
}
